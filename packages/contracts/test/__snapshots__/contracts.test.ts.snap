                  ],
                  "type": "object",
                },
              },
            },
            "description": "Session expired beyond the 5-minute grace window (\`session_expired\`)",
          },
          "413": {
            "description": "Body exceeds the route's configured 150 KB JSON limit",
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
