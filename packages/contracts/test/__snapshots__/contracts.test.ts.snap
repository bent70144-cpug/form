    "/v1/forms/{formId}/name": {
      "patch": {
        "description": "Changes \`forms.name\` ONLY. The respondent-facing title lives in the draft schema envelope and is edited by the builder (ticket 08).",
        "operationId": "renameForm",
        "parameters": [
          {
            "in": "path",
            "name": "formId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string",
