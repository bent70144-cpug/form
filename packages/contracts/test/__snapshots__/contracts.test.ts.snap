            "description": "The renamed form summary",
          },
          "401": {
            "description": "Absent, invalid, expired, or revoked session",
          },
          "403": {
            "description": "Email not verified or no workspace yet (\`forbidden\`)",
          },
          "404": {
            "description": "Unknown id or a form of another workspace (\`not_found\`)",
          },
          "422": {
            "description": "Invalid name (\`validation_failed\`)",
          },
        },
        "summary": "Rename the form's dashboard label",
        "tags": [
          "forms",
        ],
      },
    },
    "/v1/forms/{formId}/draft": {
      "put": {
        "description": "Optimistic concurrency on \`draftVersion\`: the caller sends the last-seen integer; a mismatch answers 409 \`draft_conflict\` instead of overwriting another tab's save, and success increments \`draftVersion\` by 1. The envelope is migrated through the schemaVersion registry and validated by the shared schema engine — structural, limit, ID and NUL failures answer 422 with the engine's stable codes as field errors. The body parser limit for this route is explicitly configured at 300 KB (larger bodies answer 413 before validation).",
        "operationId": "saveFormDraft",
        "parameters": [
          {
            "in": "path",
            "name": "formId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "draftVersion": {
                    "minimum": 0,
                    "type": "integer",
                  },
                  "schema": {},
                },
                "required": [
                  "draftVersion",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "draftVersion": {
                      "minimum": 1,
                      "type": "integer",
                    },
                  },
                  "required": [
                    "draftVersion",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Draft saved; returns the NEW draft version",
          },
          "401": {
            "description": "Absent, invalid, expired, or revoked session",
          },
          "403": {
            "description": "Email not verified or no workspace yet (\`forbidden\`)",
          },
          "404": {
            "description": "Unknown id or a form of another workspace (\`not_found\`)",
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string",
                    },
                    "detail": {
                      "type": "string",
                    },
                    "errors": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "code": {
                            "type": "string",
                          },
                          "message": {
                            "type": "string",
                          },
                          "path": {
                            "type": "string",
                          },
                        },
                        "required": [
                          "path",
                          "code",
                          "message",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "status": {
                      "type": "integer",
                    },
                    "title": {
                      "type": "string",
                    },
                    "type": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Stale \`draftVersion\` — another save landed first (\`draft_conflict\`)",
          },
          "413": {
            "description": "Body exceeds the route's configured 300 KB JSON limit",
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string",
                    },
                    "detail": {
                      "type": "string",
                    },
                    "errors": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "code": {
                            "type": "string",
                          },
                          "message": {
                            "type": "string",
                          },
                          "path": {
                            "type": "string",
                          },
                        },
                        "required": [
                          "path",
                          "code",
                          "message",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "status": {
                      "type": "integer",
                    },
                    "title": {
                      "type": "string",
                    },
                    "type": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Invalid wrapper (\`validation_failed\`) or schema-engine rejections (stable field codes: \`unsupported_schema_version\`, \`invalid_character\`, \`schema_too_large\`, \`too_many_blocks\`, \`duplicate_block_id\`, \`invalid_block_id\`, \`unsupported_block_kind\`, \`unknown_field\`, \`*_too_long\`, ...)",
          },
        },
        "summary": "Replace the form's FULL draft schema atomically",
        "tags": [
          "forms",
        ],
      },
    },
    "/v1/forms/{formId}/publish": {
      "post": {
        "description": "ONE transaction: locks the form row (SELECT … FOR UPDATE), re-runs the FULL publish validation, allocates the next version number, inserts the immutable form_versions snapshot, updates the published pointer and status to \`published\`, registers the public slug on first publish (\`register_form_slug\`, 10-char base62; reserved words rejected), and writes the \`form.published\` audit row and outbox event. Validation failures answer 422 with the engine's stable codes and persist NOTHING; an injected failure rolls back everything; concurrent publishes serialize on the form row. The first publish allocates the public slug; republishes keep it. Response carries worstCaseBytes/submissionCapBytes so the dashboard can render the publish-time size warning.",
        "operationId": "publishForm",
        "parameters": [
          {
            "in": "path",
            "name": "formId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "formId": {
                      "format": "uuid",
                      "type": "string",
                    },
                    "publishedAt": {
                      "type": "string",
                    },
                    "slug": {
                      "pattern": "^[A-Za-z0-9]{10}$",
                      "type": "string",
                    },
                    "status": {
                      "enum": [
                        "published",
                      ],
                      "type": "string",
                    },
                    "submissionCapBytes": {
                      "minimum": 0,
                      "type": "integer",
                    },
                    "versionId": {
                      "format": "uuid",
                      "type": "string",
                    },
                    "versionNumber": {
                      "minimum": 1,
                      "type": "integer",
                    },
                    "worstCaseBytes": {
                      "minimum": 0,
                      "type": "integer",
                    },
                  },
                  "required": [
                    "formId",
                    "status",
                    "versionId",
                    "versionNumber",
                    "slug",
                    "publishedAt",
                    "worstCaseBytes",
                    "submissionCapBytes",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Published — the immutable version + public slug + size-warning numbers",
          },
          "401": {
            "description": "Absent, invalid, expired, or revoked session",
          },
          "403": {
            "description": "Email not verified, Origin mismatch, or no workspace yet (\`forbidden\`)",
          },
          "404": {
            "description": "Unknown id or a form of another workspace (\`not_found\`)",
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string",
                    },
                    "detail": {
                      "type": "string",
                    },
                    "errors": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "code": {
                            "type": "string",
                          },
                          "message": {
                            "type": "string",
                          },
                          "path": {
                            "type": "string",
                          },
                        },
                        "required": [
                          "path",
                          "code",
                          "message",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "status": {
                      "type": "integer",
                    },
                    "title": {
                      "type": "string",
                    },
                    "type": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Draft fails publish validation (\`no_question_blocks\`, \`empty_label\`, \`welcome_not_first\`, \`ending_not_last\`, \`duplicate_block_id\`, \`multiple_welcome_blocks\`, \`multiple_ending_blocks\`, limits, ...) — nothing is persisted",
          },
        },
        "summary": "Publish (or republish) the form as a new immutable version",
        "tags": [
          "forms",
        ],
      },
    },
    "/v1/forms/{formId}/unpublish": {
      "post": {
        "description": "Sets the form status to \`closed\` and writes the \`form.unpublished\` audit row and outbox event in the same transaction. Republishing reopens the form with a new immutable version. Cross-workspace or unknown ids answer 404.",
        "operationId": "unpublishForm",
        "parameters": [
          {
            "in": "path",
            "name": "formId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "formId": {
                      "format": "uuid",
                      "type": "string",
                    },
                    "status": {
                      "enum": [
                        "closed",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "formId",
                    "status",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "The form is closed",
          },
          "401": {
            "description": "Absent, invalid, expired, or revoked session",
          },
          "403": {
            "description": "Email not verified, Origin mismatch, or no workspace yet (\`forbidden\`)",
          },
          "404": {
            "description": "Unknown id or a form of another workspace (\`not_found\`)",
          },
        },
        "summary": "Unpublish the form — it reads as closed to respondents",
        "tags": [
          "forms",
        ],
      },
    },
