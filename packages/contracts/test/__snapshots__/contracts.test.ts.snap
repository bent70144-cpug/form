                                        "enum": [
                                          "welcome",
                                        ],
                                        "type": "string",
                                      },
                                      "title": {
                                        "type": "string",
                                      },
                                    },
                                    "required": [
                                      "id",
                                      "kind",
                                      "title",
                                    ],
                                    "type": "object",
                                  },
                                  {
                                    "additionalProperties": false,
                                    "properties": {
                                      "description": {
                                        "type": "string",
                                      },
                                      "id": {
                                        "$ref": "#/anyOf/0/properties/schema/properties/blocks/items/anyOf/0/properties/id",
                                      },
                                      "kind": {
                                        "enum": [
                                          "short_text",
                                        ],
                                        "type": "string",
                                      },
                                      "label": {
                                        "type": "string",
                                      },
                                      "placeholder": {
                                        "type": "string",
                                      },
                                      "required": {
                                        "type": "boolean",
                                      },
                                    },
                                    "required": [
                                      "id",
                                      "kind",
                                      "label",
                                      "required",
                                    ],
                                    "type": "object",
                                  },
                                  {
                                    "additionalProperties": false,
                                    "properties": {
                                      "description": {
                                        "type": "string",
                                      },
                                      "id": {
                                        "$ref": "#/anyOf/0/properties/schema/properties/blocks/items/anyOf/0/properties/id",
                                      },
                                      "kind": {
                                        "enum": [
                                          "long_text",
                                        ],
                                        "type": "string",
                                      },
                                      "label": {
                                        "type": "string",
                                      },
                                      "placeholder": {
                                        "type": "string",
                                      },
                                      "required": {
                                        "type": "boolean",
                                      },
                                    },
                                    "required": [
                                      "id",
                                      "kind",
                                      "label",
                                      "required",
                                    ],
                                    "type": "object",
                                  },
                                  {
                                    "additionalProperties": false,
                                    "properties": {
                                      "description": {
                                        "type": "string",
                                      },
                                      "id": {
                                        "$ref": "#/anyOf/0/properties/schema/properties/blocks/items/anyOf/0/properties/id",
                                      },
                                      "kind": {
                                        "enum": [
                                          "ending",
                                        ],
                                        "type": "string",
                                      },
                                      "title": {
                                        "type": "string",
                                      },
                                    },
                                    "required": [
                                      "id",
                                      "kind",
                                      "title",
                                    ],
                                    "type": "object",
                                  },
                                ],
                              },
                              "type": "array",
                            },
                            "logic": {
                              "items": {
                                "additionalProperties": {},
                                "type": "object",
                              },
                              "type": "array",
                            },
                            "schemaVersion": {
                              "enum": [
                                1,
                              ],
                              "type": "number",
                            },
                            "settings": {
                              "additionalProperties": {},
                              "type": "object",
                            },
                            "theme": {
                              "additionalProperties": false,
                              "properties": {
                                "preset": {
                                  "enum": [
                                    "default",
                                  ],
                                  "type": "string",
                                },
                              },
                              "required": [
                                "preset",
                              ],
                              "type": "object",
                            },
                            "title": {
                              "type": "string",
                            },
                          },
                          "required": [
                            "schemaVersion",
                            "title",
                            "blocks",
                            "logic",
                            "theme",
                            "settings",
                          ],
                          "type": "object",
                        },
                        "status": {
                          "enum": [
                            "published",
