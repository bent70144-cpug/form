                        },
                        "versionNumber": {
                          "minimum": 1,
                          "type": "integer",
                        },
                      },
                      "required": [
                        "status",
                        "formId",
                        "versionId",
                        "versionNumber",
                        "schema",
                      ],
                      "type": "object",
                    },
                    {
                      "additionalProperties": false,
