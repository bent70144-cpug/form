                    "updatedAt": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "id",
                    "name",
                    "status",
                    "createdAt",
                    "updatedAt",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "The renamed form summary",
          },
          "401": {
            "description": "Unauthenticated (problem details, \`unauthenticated\`)",
          },
          "403": {
            "description": "Unverified email or no workspace yet (\`forbidden\`)",
          },
          "404": {
            "description": "Unknown id or a form of another workspace (\`not_found\`)",
          },
          "422": {
            "description": "Invalid name (\`validation_failed\`)",
          },
        },
        "summary": "Rename the form's dashboard label",
        "tags": [
          "forms",
        ],
      },
    },
