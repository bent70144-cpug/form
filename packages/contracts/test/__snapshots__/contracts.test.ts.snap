                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "createdAt": {
                      "type": "string",
                    },
                    "id": {
                      "format": "uuid",
                      "type": "string",
                    },
                    "name": {
                      "maxLength": 200,
                      "minLength": 1,
                      "type": "string",
                    },
                    "status": {
                      "enum": [
                        "draft",
                        "published",
                        "closed",
                      ],
                      "type": "string",
