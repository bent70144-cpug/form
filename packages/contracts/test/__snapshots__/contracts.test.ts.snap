    "/v1/public/forms/{slug}": {
      "get": {
        "description": "Wraps the security-definer \`get_published_form(slug)\` as app_user (cross-tenant by design; the slug registry is not directly readable). \`published\` → 200 with the immutable snapshot; \`closed\` (unpublished or soft-deleted) → 200 closed; \`redirect\` (superseded slug) → 308 Location /f/{canonicalSlug}; \`not_found\` → 404. Every response sends \`Cache-Control: no-store\`. Drafts are structurally unreachable. A future password gate sits in front of this endpoint.",
        "operationId": "getPublicForm",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9]{10}$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "formId": {
                          "format": "uuid",
                          "type": "string",
                        },
                        "schema": {
                          "additionalProperties": false,
                          "properties": {
                            "blocks": {
                              "items": {
                                "anyOf": [
                                  {
                                    "additionalProperties": false,
                                    "properties": {
                                      "description": {
                                        "type": "string",
                                      },
                                      "id": {
