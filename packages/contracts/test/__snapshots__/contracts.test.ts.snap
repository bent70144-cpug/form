                                    "properties": {
                                      "description": {
                                        "type": "string",
                                      },
                                      "id": {
                                        "$ref": "#/properties/draft/properties/schema/properties/blocks/items/anyOf/0/properties/id",
                                      },
                                      "kind": {
                                        "enum": [
                                          "short_text",
                                        ],
                                        "type": "string",
                                      },
                                      "label": {
                                        "type": "string",
                                      },
                                      "placeholder": {
                                        "type": "string",
                                      },
                                      "required": {
                                        "type": "boolean",
                                      },
                                    },
                                    "required": [
                                      "id",
                                      "kind",
                                      "label",
                                      "required",
                                    ],
                                    "type": "object",
