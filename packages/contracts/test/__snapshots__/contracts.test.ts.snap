                    },
                    "type": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Answer validation against the pinned schema failed (\`validation_failed\` with per-answer codes: \`unknown_block_id\`, \`answer_to_non_question\`, \`required_answer_missing\`, \`answer_too_long\`, \`invalid_character\`, \`submission_too_large\`, \`invalid_answer_type\`)",
          },
          "429": {
            "description": "Session-creation limit exhausted on the paired session route (\`rate_limited\`)",
          },
        },
        "summary": "Submit answers for a public session (UNauthenticated, cookie-less)",
        "tags": [
