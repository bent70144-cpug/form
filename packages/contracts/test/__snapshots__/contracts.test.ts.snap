                          },
                          "path": {
                            "type": "string",
                          },
                        },
                        "required": [
                          "path",
                          "code",
                          "message",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "status": {
                      "type": "integer",
                    },
                    "title": {
                      "type": "string",
                    },
                    "type": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Missing X-Form-Session header (\`session_required\`)",
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string",
                    },
                    "detail": {
                      "type": "string",
                    },
                    "errors": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "code": {
                            "type": "string",
                          },
                          "message": {
                            "type": "string",
                          },
                          "path": {
