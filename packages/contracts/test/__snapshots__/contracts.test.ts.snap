                                      },
                                    },
                                    "required": [
                                      "id",
                                      "kind",
                                      "label",
                                      "required",
                                    ],
                                    "type": "object",
                                  },
                                  {
                                    "additionalProperties": false,
                                    "properties": {
                                      "description": {
                                        "type": "string",
                                      },
                                      "id": {
                                        "$ref": "#/properties/draft/properties/schema/properties/blocks/items/anyOf/0/properties/id",
                                      },
                                      "kind": {
                                        "enum": [
                                          "ending",
                                        ],
                                        "type": "string",
                                      },
                                      "title": {
