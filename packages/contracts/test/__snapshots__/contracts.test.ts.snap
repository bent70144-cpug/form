                    },
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Unknown slug (\`not_found\`)",
          },
        },
        "summary": "Read the published form by public slug (UNauthenticated, cookie-less)",
        "tags": [
          "forms",
        ],
      },
    },
    "/v1/public/forms/{slug}/sessions": {
      "post": {
        "description": "Wraps the security-definer resolve_public_form(slug) — only published, non-deleted forms resolve (404 otherwise). Returns the RAW session token ONCE (only its SHA-256 hash is stored), the 24h expiry, the pinned published version id, and the pinned schema. Rate-limited to 30 requests per hour per trusted client IP AND per form (429 rate_limited). app.workspace_id is set from the resolved form, never from the client; a forged workspace header is ignored.",
        "operationId": "createPublicSession",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9]{10}$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "expiresAt": {
                      "type": "string",
                    },
                    "pinnedVersionId": {
                      "format": "uuid",
                      "type": "string",
                    },
                    "schema": {
                      "additionalProperties": false,
                      "properties": {
                        "blocks": {
                          "items": {
                            "anyOf": [
                              {
                                "additionalProperties": false,
                                "properties": {
                                  "description": {
                                    "type": "string",
                                  },
                                  "id": {
                                    "type": "string",
                                  },
                                  "kind": {
                                    "enum": [
