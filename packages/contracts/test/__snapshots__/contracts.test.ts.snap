    "/v1/public/submissions": {
      "post": {
        "description": "ONE transaction per spec: resolve the session by the SHA-256 of the raw X-Form-Session token (resolve_form_session), reject unknown (404), expired-beyond-grace (410) or completed sessions, verify the form is still published and the pinned version exists (409 form_closed), validate the answers against the PINNED schema (422 with stable per-answer codes), lock the form row and enforce the per-form submission cap (409 form_full), insert the submission (UNIQUE form_session_id makes retries idempotent — the loser of a concurrent race gets the SAME receipt), mark the session completed, and write the submission.created audit row + outbox event. Stored answers are never returned. app.workspace_id always comes from the resolved session, never from the client.",
        "operationId": "submitPublicForm",
        "parameters": [
          {
            "description": "The raw session token from session creation.",
            "in": "header",
            "name": "X-Form-Session",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "answers": {
                    "additionalProperties": {},
                    "type": "object",
                  },
                },
                "required": [
                  "answers",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "submissionId": {
                      "format": "uuid",
                      "type": "string",
                    },
                    "submitted": {
                      "enum": [
                        true,
                      ],
                      "type": "boolean",
                    },
                  },
                  "required": [
                    "submitted",
                    "submissionId",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "The idempotent receipt (first submit or a retry/race loser)",
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "additionalProperties": false,
