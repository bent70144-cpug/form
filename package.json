{
  "name": "form",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node scripts/supervisor.mjs --dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "db:start": "tsx packages/database/src/scripts/start-embedded.ts",
    "db:stop": "tsx packages/database/src/scripts/stop-embedded.ts",
    "db:bootstrap": "tsx packages/database/src/cli/bootstrap.ts",
    "db:migrate": "tsx packages/database/src/cli/migrate.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/linux-x64",
      "embedded-postgres",
      "esbuild",
      "turbo"
    ]
  }
}